{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/sharpness-sharp.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--launch-profile", "http", "--project", "${workspaceFolder}/sharpness-sharp.csproj"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
