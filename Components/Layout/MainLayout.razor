@using sharpness_sharp.Components.UI
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject sharpness_sharp.Services.TemaState Tema

<div class="flex min-h-screen flex-col bg-crema md:flex-row" style="--color-cafe: @Tema.Color">
    <aside class="bg-cafe text-white md:w-64 md:shrink-0">
        <NavMenu />
    </aside>

    <main class="flex-1">
        <div class="flex h-14 items-center justify-end border-b border-caramelo/30 bg-espuma px-4">
            <AuthorizeView>
                <NotAuthorized>
                    <div class="ui-btn ui-btn-primary">
                        <NavLink href="Account/Login">Iniciar Sesion</NavLink>
                    </div>
                </NotAuthorized>
                <Authorized>
                    <AuthorizeView Roles="Cliente" Context="cliente">
                        <AuthorizeView Roles="ClienteVIP" Context="vip">
                            <Authorized><span class="rounded-xl bg-caramelo px-3 py-1 text-sm font-bold text-white">VIP</span></Authorized>
                            <NotAuthorized><VipModal /></NotAuthorized>
                        </AuthorizeView>
                    </AuthorizeView>
                    <div class="ui-btn-primary ui-btn mx-2">
                        <NavLink href="Account/Manage"> @context.User.Identity?.Name
                        </NavLink>
                    </div>
                    <div class="ui-btn-primary ui-btn mx-2">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit">
                                Logout
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class=" px-4 pt-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed inset-x-0 bottom-0 z-50 hidden bg-yellow-100 px-5 py-2 shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss absolute right-3 top-2 cursor-pointer">🗙</span>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        Tema.OnCambio += OnTemaCambio;
    }

    private void OnTemaCambio() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Tema.OnCambio -= OnTemaCambio;
    }
}