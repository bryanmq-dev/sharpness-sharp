<section class="ui-panel">
    <div class="mb-6 space-y-1">
        <h2 class="ui-section-title">@Title</h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="text-sm text-stone-500">@Subtitle</p>
        }
    </div>

    <div class="space-y-5">
        @ChildContent
    </div>
</section>

@code {
    /// <summary>Encabezado del panel.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    /// <summary>Línea de apoyo bajo el título. Opcional.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Contenido del panel.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
