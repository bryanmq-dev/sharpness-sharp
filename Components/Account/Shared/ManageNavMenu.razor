@using Microsoft.AspNetCore.Identity
@using sharpness_sharp.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="flex flex-col gap-1">
    <li><NavLink class="ui-nav-link" href="Account/Manage" Match="NavLinkMatch.All">Perfil</NavLink></li>
    <li><NavLink class="ui-nav-link" href="Account/Manage/Email">Email</NavLink></li>
    <li><NavLink class="ui-nav-link" href="Account/Manage/ChangePassword">Contrasena</NavLink></li>
    @if (hasExternalLogins)
    {
        <li><NavLink class="ui-nav-link" href="Account/Manage/ExternalLogins">Accesos externos</NavLink></li>
    }
    <li><NavLink class="ui-nav-link" href="Account/Manage/TwoFactorAuthentication">Dos factores</NavLink></li>
    <li><NavLink class="ui-nav-link" href="Account/Manage/Passkeys">Passkeys</NavLink></li>
    <li><NavLink class="ui-nav-link" href="Account/Manage/PersonalData">Datos personales</NavLink></li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
