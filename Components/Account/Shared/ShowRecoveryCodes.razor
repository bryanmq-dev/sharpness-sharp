<ManagePanel Title="Codigos de recuperacion" Subtitle="Cada codigo sirve una sola vez.">
    <StatusMessage Message="@StatusMessage" />

    <div class="ui-alert ui-alert-warn" role="alert">
        <strong>Guardalos en un lugar seguro.</strong>
        <p class="mt-1">Si perdes el dispositivo y no tenes estos codigos, perdes el acceso a la cuenta.</p>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="rounded-xl border border-stone-200 bg-stone-50 px-3 py-2 text-center font-mono text-sm tracking-wider text-stone-800">@recoveryCode</code>
        }
    </div>
</ManagePanel>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
