@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<AuthCard Title="Enlace no valido" Subtitle="El enlace de restablecimiento ya no sirve.">
    <ChildContent>
        <p class="text-sm text-stone-600" role="alert">
            Los enlaces caducan por seguridad. Pedi uno nuevo para continuar.
        </p>
    </ChildContent>

    <Footer>
        <p><a href="Account/ForgotPassword" class="ui-link">Pedir un enlace nuevo</a></p>
    </Footer>
</AuthCard>

