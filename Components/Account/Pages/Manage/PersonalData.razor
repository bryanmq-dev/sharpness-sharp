@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using sharpness_sharp.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data</PageTitle>

<ManagePanel Title="Datos personales" Subtitle="Descarga o elimina la informacion de tu cuenta.">
    <StatusMessage />

    <p class="text-sm text-stone-600">
        Tu cuenta guarda los datos que nos diste. Desde aca podes bajarlos o borrarlos.
    </p>

    <div class="ui-alert ui-alert-warn">
        <strong>Borrar estos datos elimina tu cuenta de forma permanente.</strong> No se puede deshacer.
    </div>

    <div class="flex flex-wrap gap-2">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="ui-btn ui-btn-soft" type="submit">Descargar mis datos</button>
        </form>
        <a href="Account/Manage/DeletePersonalData" class="ui-btn ui-btn-danger">Eliminar cuenta</a>
    </div>
</ManagePanel>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
