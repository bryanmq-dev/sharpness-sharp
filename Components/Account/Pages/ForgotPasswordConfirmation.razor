@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<AuthCard Title="Enlace enviado" Subtitle="Revisa tu correo para continuar.">
    <ChildContent>
        <p class="text-sm text-stone-600" role="alert">
            Si existe una cuenta con ese email, va a recibir un enlace para restablecer la contrasena.
        </p>
    </ChildContent>

    <Footer>
        <p><a href="Account/Login" class="ui-link">Volver a iniciar sesion</a></p>
    </Footer>
</AuthCard>

