@page "/vip/productos"
@using Microsoft.AspNetCore.Authorization
@using sharpness_sharp.Components.UI
@using sharpness_sharp.Data.Dtos
@using sharpness_sharp.Services
@attribute [Authorize(Roles = "ClienteVIP")]
@inject ProductoService productoService
@inject CarritoState carrito

<PageTitle>Productos VIP</PageTitle>

<h1 class="mb-4 text-2xl font-bold text-cafe">Productos exclusivos VIP</h1>

<div class="grid lg:grid-cols-6 gap-4 md:grid-cols-4 grid-flow-row">
    @foreach (ProductoDto producto in lstProductos)
    {
        <ProductCard Producto=@producto OnAgregar="carrito.Agregar" />
    }
</div>

@code {
    List<ProductoDto> lstProductos = new();

    protected override async Task OnInitializedAsync() => lstProductos = await productoService.ObtenerProductosVip();
}
