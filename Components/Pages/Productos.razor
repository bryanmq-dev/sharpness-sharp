@page "/productos"
@using sharpness_sharp.Components.UI
@using sharpness_sharp.Services
@using sharpness_sharp.Data.Dtos
@inject ProductoService productoService

<PageTitle>Productos</PageTitle>

<div class="flex w-full items-center gap-2">
    <ProductSearchBox LimpiarFiltroCB='LimpiarFiltro' BuscarFiltroCB='FiltrarProductos' />
    <CategoriaFiltro Categorias="categorias" CategoriaCB="FiltrarCategoria" />
</div>

@if (lstProductosFiltrados is null || lstProductosFiltrados?.Count == 0)
{
    <p>Aun no se tienen productos registrados</p>
}
else
{
    <div class="grid lg:grid-cols-6 gap-4 md:grid-cols-4 grid-flow-row ">
        @foreach (ProductoDto producto in lstProductosFiltrados ?? new())
        {
            <ProductCard Producto=@producto />
        }
    </div>
}


@code {
    List<ProductoDto>? lstProductos;
    List<ProductoDto>? lstProductosFiltrados;
    List<string> categorias = new();
    string filtroTexto = string.Empty;
    string filtroCategoria = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        lstProductos = await productoService.ObtenerProductos();
        lstProductosFiltrados = lstProductos;
        categorias = (await productoService.ObtenerCategorias()).Select(categoria => categoria.Nombre).ToList();
    }

    void FiltrarProductos(string filtro)
    {
        filtroTexto = filtro;
        Aplicar();
    }

    void FiltrarCategoria(string categoria)
    {
        filtroCategoria = categoria;
        Aplicar();
    }

    void LimpiarFiltro()
    {
        filtroTexto = string.Empty;
        Aplicar();
    }

    void Aplicar()
    {
        lstProductosFiltrados = lstProductos?
            .Where(producto => producto.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
            .Where(producto => filtroCategoria == string.Empty || producto.Categoria == filtroCategoria)
            .ToList();
    }
}
