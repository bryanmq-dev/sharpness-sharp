@page "/productos"
@using sharpness_sharp.Components.UI
@using sharpness_sharp.Data.Models

<PageTitle>Productos</PageTitle>

<div class="flex w-full items-center gap-2">
    <ProductSearchBox LimpiarFiltroCB='LimpiarFiltro' BuscarFiltroCB='FiltrarProductos' />
    <CategoriaFiltro Categorias="categorias" CategoriaCB="FiltrarCategoria" />
</div>

@if (lstProductosFiltrados is null || lstProductosFiltrados?.Count == 0)
{
    <p>Aun no se tienen productos registrados</p>
}
else
{
    <div class="grid lg:grid-cols-6 gap-4 md:grid-cols-4 grid-flow-row ">
        @foreach (Producto producto in lstProductosFiltrados ?? new())
        {
            <ProductCard Producto=@producto />
        }
    </div>
}


@code {
    List<Producto>? lstProductos;
    List<Producto>? lstProductosFiltrados;
    List<string> categorias = new();
    string filtroTexto = string.Empty;
    string filtroCategoria = string.Empty;


    protected override void OnInitialized()
    {
        lstProductos = new List<Producto>
        {
            new Producto("https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd", "Americano", 12, 100, "Cafe"),
            new Producto("https://images.unsplash.com/photo-1572442388796-11668a67e53d", "Capuccino", 16, 90, "Cafe"),
            new Producto("https://images.unsplash.com/photo-1541167760496-1628856ab772", "Latte", 18, 80, "Cafe"),
            new Producto("https://images.unsplash.com/photo-1517256064527-09c73fc73e38", "Flat White", 17, 60, "Cafe"),
            new Producto("https://images.unsplash.com/photo-1442512595331-e89e73853f31", "Cafe Filtrado", 15, 40, "Cafe"),
            new Producto("https://images.unsplash.com/photo-1461023058943-07fcbe16d735", "Cafe Helado", 18, 50, "Bebidas"),
            new Producto("https://images.unsplash.com/photo-1556679343-c7306c1976bc", "Te Helado", 14, 45, "Bebidas"),
            new Producto("https://images.unsplash.com/photo-1544787219-7f47ccb76574", "Te con Leche", 13, 35, "Bebidas"),
            new Producto("https://images.unsplash.com/photo-1555507036-ab1f4038808a", "Croissant", 12, 60, "Panaderia"),
            new Producto("https://images.unsplash.com/photo-1551024506-0bccd828d307", "Donas", 15, 80, "Panaderia"),
            new Producto("https://images.unsplash.com/photo-1558961363-fa8fdf82db35", "Galletas con Chips", 8, 120, "Panaderia"),
            new Producto("https://images.unsplash.com/photo-1578985545062-69928b1d9587", "Pastel de Chocolate", 45, 25, "Postres"),
            new Producto("https://images.unsplash.com/photo-1571115177098-24ec42ed204d", "Brownie", 14, 55, "Postres"),
            new Producto("https://images.unsplash.com/photo-1495147466023-ac5c588e2e94", "Cupcakes", 18, 70, "Postres")
        };
        lstProductosFiltrados = lstProductos;
        categorias = lstProductos.Select(producto => producto.Categoria).Distinct().ToList();
        base.OnInitialized();
    }

    void FiltrarProductos(string filtro)
    {
        filtroTexto = filtro;
        Aplicar();
    }

    void FiltrarCategoria(string categoria)
    {
        filtroCategoria = categoria;
        Aplicar();
    }

    void LimpiarFiltro()
    {
        filtroTexto = string.Empty;
        Aplicar();
    }

    void Aplicar()
    {
        lstProductosFiltrados = lstProductos?
            .Where(producto => producto.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
            .Where(producto => filtroCategoria == string.Empty || producto.Categoria == filtroCategoria)
            .ToList();
    }
}
