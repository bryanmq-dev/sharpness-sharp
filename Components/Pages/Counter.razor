@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="inline-block cursor-pointer rounded border text-center text-sm font-medium px-3 py-1.5 border-blue-600 bg-blue-600 text-white hover:bg-blue-700" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
