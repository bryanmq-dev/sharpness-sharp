@page "/mis-compras"
@using Microsoft.AspNetCore.Authorization
@using sharpness_sharp.Data.Dtos
@using sharpness_sharp.Services
@attribute [Authorize(Roles = "Cliente")]
@inject VentaService ventaService

<PageTitle>Mis compras</PageTitle>

<h1 class="mb-4 text-2xl font-bold text-cafe">Mis compras</h1>

@if (ventas.Count == 0)
{
    <p>Aun no realizaste compras.</p>
}

@foreach (var venta in ventas)
{
    <div class="ui-panel mb-4">
        <p class="font-semibold">Compra #@venta.Id - @venta.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        <ul class="my-2 text-sm">
            @foreach (var detalle in venta.Detalles)
            {
                <li>@detalle.Cantidad x @detalle.Producto - Bs. @detalle.PrecioUnitario</li>
            }
        </ul>
        <p class="font-bold">Total: Bs. @venta.Total</p>
    </div>
}

@code {
    List<VentaDto> ventas = new();

    protected override async Task OnInitializedAsync() => ventas = await ventaService.ObtenerMias();
}
